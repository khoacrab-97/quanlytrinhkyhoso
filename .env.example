# Chuỗi kết nối PostgreSQL
DATABASE_URL="postgresql://qltk:qltk_dev_password@localhost:5433/qltk?schema=public"
# Khóa ký phiên đăng nhập (JWT) - BẮT BUỘC đổi khi triển khai production (>= 32 ký tự ngẫu nhiên)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Thư mục lưu file đính kèm (ngoài thư mục public để không truy cập trực tiếp được)
UPLOAD_DIR="./storage/uploads"
# Thư mục lưu bản sao lưu
BACKUP_DIR="./storage/backups"
# Dung lượng tối đa mỗi file đính kèm (MB)
MAX_UPLOAD_MB=25
