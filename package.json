{
  "name": "quan-ly-trinh-ky-ho-so",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ thống quản lý trình ký hồ sơ cho doanh nghiệp xây dựng",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:sample": "tsx prisma/seed.ts --sample",
    "db:reset": "tsx scripts/purge-sample.ts && tsx prisma/seed.ts --sample",
    "db:backup": "tsx scripts/backup.ts",
    "user:reset-password": "tsx scripts/reset-password.ts",
    "test": "tsx --test tests/workflow.test.ts tests/signingForms.test.ts tests/approval.test.ts",
    "db:local": "node scripts/dev-db.mjs",
    "db:purge-sample": "tsx scripts/purge-sample.ts",
    "test:api": "tsx tests/api.smoke.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.29",
    "pdfmake": "^0.2.20",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1",
    "server-only": "^0.0.1",
    "swr": "^2.3.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/pdfmake": "^0.2.12",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "embedded-postgres": "^17.5.0-beta.15",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "@prisma/client@6.16.2": true,
    "@prisma/engines@6.16.2": true,
    "@tailwindcss/oxide@4.1.13": true,
    "esbuild@0.25.12": true,
    "prisma@6.16.2": true,
    "sharp@0.34.5": true,
    "@embedded-postgres/windows-x64@17.5.0-beta.15": true
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
